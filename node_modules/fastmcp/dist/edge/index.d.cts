 * import { EdgeFastMCP } from "fastmcp/edge";
 * import { z } from "zod";
 *
 * const server = new EdgeFastMCP({ name: "MyMCP", version: "1.0.0" });
 *
 * server.addTool({
 *   name: "hello",
 *   description: "Say hello",
 *   parameters: z.object({ name: z.string() }),
 *   execute: async ({ name }) => `Hello, ${name}!`,
 * });
